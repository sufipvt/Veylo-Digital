---
import Icon from './Icon.astro';
import LeadForm from './LeadForm.astro';
import { wa } from '../site';
const { title = 'Your next listing could look like this', source = 'page', waText } = Astro.props;
---
<section class="sec close">
  <div class="wrap contact-grid">
    <div>
      <h2>{title}</h2>
      <p class="lede">Tell us about your listings. We'll reply to book a free growth call and plan your first shoot.</p>
      <div class="reach"><a class="btn" href={wa(waText)}><Icon name="whatsapp" /> Chat on WhatsApp</a></div>
    </div>
    <LeadForm variant="full" source={source} />
  </div>
</section>
