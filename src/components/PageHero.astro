---
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
const { title, lede, crumb, img, alt } = Astro.props;
---
<section class="phero">
  <div class:list={['wrap', img && 'phero-grid']}>
    <div>
    {crumb && <a class="crumb" href={crumb[1]}><Icon name="arrow" class="back" /> {crumb[0]}</a>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
    </div>
    {img && <figure class="frame"><Image src={img} alt={alt} widths={[500, 900]} sizes="(max-width: 860px) 100vw, 40vw" loading="eager" /><figcaption>Sample render</figcaption></figure>}
  </div>
</section>
