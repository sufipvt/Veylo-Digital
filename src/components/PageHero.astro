---
import Arc from './Arc.astro';
import Icon from './Icon.astro';
const { title, lede, crumb } = Astro.props;
---
<section class="phero">
  <Arc />
  <div class="wrap">
    {crumb && <a class="crumb" href={crumb[1]}><Icon name="arrow" class="back" /> {crumb[0]}</a>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>
