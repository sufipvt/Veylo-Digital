---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Close from '../components/Close.astro';
import { Image } from 'astro:assets';
import lit from '../assets/renders/tower-lit.png';
import dusk from '../assets/renders/tower-dusk.png';
import aerial from '../assets/renders/aerial.png';
import street from '../assets/renders/street.png';
// TODO(owner): replace these sample renders with real shoots, drone stills and reel posters.
const work = [
  { img: lit, cat: 'Shoots', title: 'Twilight exterior', alt: 'Glass tower at blue hour, lights on' },
  { img: aerial, cat: 'Drone', title: 'Aerial location shot', alt: 'Aerial view of towers and lit roads' },
  { img: street, cat: 'Shoots', title: 'Street approach', alt: 'Street-level view of lit towers' },
  { img: dusk, cat: 'Social', title: 'Reel opening frame', alt: 'Tower at dusk before the lights come on' },
];
const cats = ['All', 'Shoots', 'Drone', 'Social'];
---
<Base title="Work" description="The look we shoot for: twilight exteriors, aerials and reels for real estate agents and firms.">
  <PageHero title="The look we shoot for" lede="These are sample renders that show the style we deliver. Our client work will appear here as projects go live." />
  <section class="sec work" style="padding-top:24px">
    <div class="wrap">
      <div class="filters" role="group" aria-label="Filter work">
        {cats.map((c, i) => <><input type="radio" name="f" id={`f-${c}`} checked={i === 0} /><label class="btn" for={`f-${c}`}>{c}</label></>)}
      </div>
      <div class="grid">
        {work.map((w) => (
          <figure class="frame" data-cat={w.cat}>
            <Image src={w.img} alt={w.alt} widths={[500, 900]} sizes="(max-width: 860px) 100vw, 50vw" />
            <figcaption>Sample · {w.cat} · {w.title}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
  <Close source="work" />
</Base>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 32px; }
  .filters input { position: absolute; opacity: 0; }
  .filters input:checked + label { background: var(--blue-btn); border-color: var(--blue-btn); color: #fff; }
  .filters input:focus-visible + label { outline: 2px solid var(--blue-hi); outline-offset: 3px; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
  .grid .frame { aspect-ratio: 4 / 3; margin: 0; }
  .grid figcaption { position: absolute; left: 18px; bottom: 16px; margin: 0; color: var(--silver-hi); text-shadow: 0 1px 12px #000; }
  .work:has(#f-Shoots:checked) .frame:not([data-cat='Shoots']),
  .work:has(#f-Drone:checked) .frame:not([data-cat='Drone']),
  .work:has(#f-Social:checked) .frame:not([data-cat='Social']) { display: none; }
  @media (max-width: 700px) { .grid { grid-template-columns: 1fr; } }
</style>
